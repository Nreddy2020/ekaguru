# Backend-only configuration. Never commit an actual key.
# Existing installations default to gemini when GURU_PROVIDER is omitted.
GURU_PROVIDER=gemini
GURU_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# To choose OpenAI, set GURU_PROVIDER=openai and a vision-capable GURU_MODEL.
# Example model documented by OpenAI: gpt-6-astra. Evaluate cost/quality first.
# OpenAI requests use Responses API, JSON mode, store=false and no automatic retries.
# Each new lesson currently performs three model calls (vision, plan, source review).
# Optional offline OCR and scan configuration
OCR_LANGUAGES=eng
TESSDATA_DIR=
TEXTBOOK_SCAN_DIR=

# Cost and abuse control: paid model calls per account per UTC day (0 disables)
GURU_DAILY_LESSON_LIMIT=20
GURU_DAILY_QUERY_LIMIT=200
# Mastery bridge: page checkpoints reach canonical mastery only when enabled AND
# the lesson has a curator-verified concept mapping AND the depth passed educator review.
GURU_MASTERY_BRIDGE=disabled
GURU_EVAL_MIN_PASSED_CASES=20
# Account recovery mail delivery (trusted server-side webhook accepting {to,subject,text})
AUTH_MAIL_WEBHOOK_URL=
AUTH_MAIL_WEBHOOK_TOKEN=
APP_PUBLIC_URL=http://localhost:3000

# Output token cap for lesson generation (Gemini counts reasoning tokens against it)
GURU_MAX_OUTPUT_TOKENS=48000
# Provider call deadline and bounded retry waits for transient 429/503 errors (at most 2 retries)
GURU_REQUEST_TIMEOUT_MS=180000
GURU_RETRY_WAITS_MS=15000,30000
# Server-side debug dumps of raw model responses for curators (leave empty in production)
GURU_DEBUG_DIR=
# Durable lesson generation worker (runs inside the backend process)
GURU_WORKER=enabled
GURU_WORKER_CONCURRENCY=1
GURU_JOB_MAX_ATTEMPTS=2
GURU_JOB_STALE_MINUTES=15

# First-time page reading (OCR) worker: simultaneous pages per process (default 1). Shares GURU_WORKER,
# GURU_JOB_MAX_ATTEMPTS and GURU_JOB_STALE_MINUTES with the lesson worker.
# GURU_OCR_WORKER_CONCURRENCY=1
