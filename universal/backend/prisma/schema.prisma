// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Module 1: Domain Model ---

enum SubjectCategory {
  TECHNOLOGY
  ACADEMIC
  SOFT_SKILL
  LANGUAGE
  ARTS
}

enum TargetRole {
  KID
  STUDENT
  PROFESSIONAL
  ARCHITECT
  PROFESSOR
  RESEARCHER
}

enum SubjectStatus {
  DRAFT
  REVIEW
  PUBLISHED
  DEPRECATED
}

model Subject {
  id          String          @id @default(uuid())
  name        String
  category    SubjectCategory
  description String
  version     String          @default("1.0.0")
  status      SubjectStatus   @default(DRAFT)
  
  targetRoles TargetRole[]
  metaTags    String[]        // e.g. ["Cloud", "DevOps"]

  phases      Phase[]
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Phase {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  
  name        String   // e.g. "Beginner", "Advanced"
  orderIndex  Int
  outcome     String   // "Able to write basic code"

  modules     Module[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Module {
  id          String   @id @default(uuid())
  phaseId     String
  phase       Phase    @relation(fields: [phaseId], references: [id])
  
  title       String
  objectives  String[]
  durationMin Int      @default(60)

  topics      Topic[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Topic {
  id          String   @id @default(uuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  
  title       String
  
  // The "20-Field" Standard stored as JSON to allow flexibility/evolution
  // Includes: arch, security, performance, troubleshooting, etc.
  contentData Json 
  
  // Multi-Persona Explanations (Legacy - migrating to Lenses)
  // { "kid": "...", "pro": "..." }
  explanations Json

  // Relationships
  atoms       ConceptAtom[] // The Micro-Knowledge Graph Children

  labs        Lab[]
  assessments Assessment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Module 3: Knowledge Graph (The Brain) ---

enum AtomType {
  CONCEPT     // Abstract idea (e.g. "Velocity")
  ENTITY      // Concrete object (e.g. "Car")
  PROCESS     // Action/Verb (e.g. "Moving")
  PRINCIPLE   // Law/Rule (e.g. "F=ma")
}

model ConceptAtom {
  id          String   @id @default(uuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])
  
  name        String
  type        AtomType
  
  // The "Beautiful Data" - definitions in purest form
  definition  String
  
  // Graph Connections
  outgoing    ConceptRelation[] @relation("SourceAtom")
  incoming    ConceptRelation[] @relation("TargetAtom")
  
  // Adaptive Content
  lenses      ComplexityLens[]

  canonicalConcept Concept?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RelationType {
  PREREQUISITE    // A must be known before B
  COMPONENT_OF    // A is part of B
  ANALOGY_FOR     // A is like B
  EVOLUTION_OF    // B came from A
}

model ConceptRelation {
  id          String       @id @default(uuid())
  
  sourceId    String
  source      ConceptAtom  @relation("SourceAtom", fields: [sourceId], references: [id])
  
  targetId    String
  target      ConceptAtom  @relation("TargetAtom", fields: [targetId], references: [id])
  
  type        RelationType
  weight      Float        @default(1.0) // Strength of connection
  description String?      // Explain WHY they are related
  
  createdAt   DateTime     @default(now())
}

model ComplexityLens {
  id          String      @id @default(uuid())
  atomId      String
  atom        ConceptAtom @relation(fields: [atomId], references: [id])
  
  role        TargetRole  // KID, STUDENT, GENIUS
  
  narrative   String      // The story
  analogy     String      // "Imagine a..."
  visualPrompt String?    // For GenAI image generation
  historicalContext String? // Historical background, e.g. "Newton first formulated..."
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@unique([atomId, role]) // One lens per role per atom
}

// --- Module 5: Labs ---

model Lab {
  id          String   @id @default(uuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id])

  title       String
  instructions String
  commands     String[] // or Json
  solution     String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Module 6: Assessments ---

enum QuestionType {
  MCQ
  SCENARIO
  DESIGN
}

model Assessment {
  id          String     @id @default(uuid())
  topicId     String
  topic       Topic      @relation(fields: [topicId], references: [id])

  questions   Question[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Question {
  id           String       @id @default(uuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id])

  text         String
  type         QuestionType
  options      String[]     // For MCQ
  correctAnswer String
  explanation  String
  complexity   Int          // 1-10

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// --- Module 2: AI Templates ---

model PromptTemplate {
  id             String   @id @default(uuid())
  name           String   @unique // e.g. "topic_deep_dive"
  version        Int      @default(1)
  
  systemPrompt   String
  userPrompt     String   // with {{variables}}
  outputSchema   Json     // Zod/JSON Schema
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- Module 3: User & Parent Management ---

enum UserRole {
  PARENT
  STUDENT
  ADMIN
}

model Parent {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  createdAt     DateTime  @default(now())
  children      Child[]
  consentGiven  Boolean   @default(false)
  consentDate   DateTime?
}

model Child {
  id          String    @id @default(uuid())
  parentId    String
  parent      Parent    @relation(fields: [parentId], references: [id])
  name        String
  age         Int
  createdAt   DateTime  @default(now())
  sessions    LearningSession[]
  progress    ChildProgress?
  learner     Learner?
}

model ChildProgress {
  id              String   @id @default(uuid())
  childId         String   @unique
  child           Child    @relation(fields: [childId], references: [id])
  currentMastery  Float    @default(0)
  fearIndex       Float    @default(5.0)  // 0-10 scale
  confidence      Float    @default(5.0)  // 0-10 scale
  streakDays      Int      @default(0)
  lastActive      DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningSession {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id])
  concept     String
  phase       String   // observe, diagnose, struggle, explain, reflect, transfer
  status      String   @default("active") // active, completed, abandoned
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  events      SessionEvent[]
  evidence    LearningEvidence[]
}

model SessionEvent {
  id          String          @id @default(uuid())
  sessionId   String
  session     LearningSession @relation(fields: [sessionId], references: [id])
  type        String          // response, hint, mastery, struggle
  content     String
  timestamp   DateTime        @default(now())
}

// ============================================================
// EKAGURU V2 - Universal Learning Intelligence
// Learning Library Domain - Phase 2.1A Persistence Foundation
// DO NOT REMOVE: Legacy bridges preserve backward compatibility.
// ============================================================

// ------------------------------------------------------------
// V2 Enums
// ------------------------------------------------------------

enum LearnerType {
  CHILD
  STUDENT
  ADULT
  PROFESSIONAL
}

enum MaterialType {
  TEXTBOOK
  PDF
  IMAGE
  NOTE
  WORKSHEET
  ASSIGNMENT
  WEB_RESOURCE
  VIDEO
}

enum MaterialStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED
}

enum ProcessingStatus {
  UPLOADED
  VALIDATING
  STORED
  EXTRACTING
  STRUCTURING
  CONCEPT_MAPPING
  INDEXING
  READY
  FAILED
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ConceptType {
  CONCEPT
  ENTITY
  PROCESS
  PRINCIPLE
  SKILL
}

enum ConceptStatus {
  ACTIVE
  RETIRED
}

enum EntityType {
  CANDIDATE
  CONCEPT
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlignmentDecisionType {
  AUTO_LINK
  REVIEW_REQUIRED
  NEW_CONCEPT
}

enum BoardType {
  CBSE
  ICSE
  CAMBRIDGE
  STATE_BOARD
  INTERNATIONAL_BACCALAUREATE
}

enum CurriculumStatus {
  DRAFT
  VALIDATING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum MasteryStatus {
  NOT_STARTED
  NEEDS_REMEDIATION
  IN_PROGRESS
  MASTERED
}

enum GradeBand {
  EARLY_CHILDHOOD
  PRIMARY
  MIDDLE_SCHOOL
  HIGH_SCHOOL
  ADVANCED
}

enum CandidateStatus {
  PENDING
  SCORING
  RESOLVED
  REJECTED
}

enum ConceptRelationshipType {
  PREREQUISITE
  RELATED
  COMPONENT_OF
  APPLICATION_OF
  CAUSES
  CONTRASTS
  ANALOGY
  EVOLUTION_OF
}

enum EvidenceType {
  ANSWER
  EXPLANATION
  PRACTICE
  ASSESSMENT
  TRANSFER
  TEACH_BACK
  OBSERVATION
  SELF_REPORT
}

enum EvidenceOutcome {
  CORRECT
  PARTIAL
  INCORRECT
  DEVELOPING
  UNKNOWN
}

// ------------------------------------------------------------
// Learner  (Bridge: legacyChildId -> Child)
// ------------------------------------------------------------

model Learner {
  id                String           @id @default(uuid())

  legacyChildId     String?          @unique
  legacyChild       Child?           @relation(fields: [legacyChildId], references: [id])

  name              String
  learnerType       LearnerType
  preferredLanguage String?          @default("en")
  dateOfBirth       DateTime?

  materials         LearningMaterial[]
  evidence          LearningEvidence[]
  conceptMasteries  LearnerConceptMastery[]
  objectiveMasteries LearnerObjectiveMastery[]
  curriculumEnrollments LearnerCurriculumEnrollment[]
  masteryHistories  MasteryHistory[]
  curriculumFrontiers LearnerCurriculumFrontier[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ------------------------------------------------------------
// Learning Material
// ------------------------------------------------------------

model LearningMaterial {
  id                  String           @id @default(uuid())

  learnerId           String
  learner             Learner          @relation(fields: [learnerId], references: [id])

  title               String
  description         String?

  materialType        MaterialType
  status              MaterialStatus   @default(DRAFT)
  processingStatus    ProcessingStatus @default(UPLOADED)

  subjectName         String?
  gradeLevel          String?
  language            String?          @default("en")

  originalFileName    String?
  mimeType            String?
  fileSizeBytes       BigInt?
  storageKey          String?

  failureReason       String?
  processingVersion   String?

  documents           Document[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([learnerId])
  @@index([processingStatus])
  @@index([materialType])
}

// ------------------------------------------------------------
// Document
// ------------------------------------------------------------

model Document {
  id             String           @id @default(uuid())

  materialId     String
  material       LearningMaterial @relation(fields: [materialId], references: [id])

  title          String?
  status         DocumentStatus   @default(PENDING)

  pageCount      Int?
  extractedText  String?

  pages          DocumentPage[]
  chapters       ContentChapter[]
  chunks         ContentChunk[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([materialId])
  @@index([status])
}

// ------------------------------------------------------------
// Document Page
// ------------------------------------------------------------

model DocumentPage {
  id               String   @id @default(uuid())

  documentId       String
  document         Document @relation(fields: [documentId], references: [id])

  pageNumber       Int
  text             String?
  imageStorageKey  String?
  ocrApplied       Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([documentId, pageNumber])
  @@index([documentId])
}

// ------------------------------------------------------------
// Content Chapter
// ------------------------------------------------------------

model ContentChapter {
  id            String   @id @default(uuid())

  documentId    String
  document      Document @relation(fields: [documentId], references: [id])

  title         String
  chapterNumber Int?
  orderIndex    Int

  topics        ContentTopic[]
  chunks        ContentChunk[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([documentId, orderIndex])
  @@index([documentId])
}

// ------------------------------------------------------------
// Content Topic
// ------------------------------------------------------------

model ContentTopic {
  id          String         @id @default(uuid())

  chapterId   String
  chapter     ContentChapter @relation(fields: [chapterId], references: [id])

  title       String
  orderIndex  Int

  chunks      ContentChunk[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([chapterId, orderIndex])
  @@index([chapterId])
}

// ------------------------------------------------------------
// Content Chunk
// ------------------------------------------------------------

model ContentChunk {
  id             String          @id @default(uuid())

  documentId     String
  document       Document        @relation(fields: [documentId], references: [id])

  chapterId      String?
  chapter        ContentChapter? @relation(fields: [chapterId], references: [id])

  topicId        String?
  topic          ContentTopic?   @relation(fields: [topicId], references: [id])

  sequenceNumber Int
  content        String

  pageStart      Int?
  pageEnd        Int?

  metadata       Json?

  conceptLinks      ConceptChunk[]
  conceptCandidates ConceptCandidate[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([documentId, sequenceNumber])
  @@index([chapterId])
  @@index([topicId])
}

// ------------------------------------------------------------
// Canonical Concept  (Bridge: legacyAtomId -> ConceptAtom)
// ------------------------------------------------------------

model Concept {
  id             String       @id @default(uuid())

  legacyAtomId   String?      @unique
  legacyAtom     ConceptAtom? @relation(fields: [legacyAtomId], references: [id])

  canonicalName  String
  normalizedName String
  definition     String?
  conceptType    ConceptType  @default(CONCEPT)
  status         ConceptStatus @default(ACTIVE)

  domain         String?      @default("General")
  gradeBand      GradeBand    @default(PRIMARY)
  metadata       Json?

  sourceChunks   ConceptChunk[]

  outgoing       ConceptRelationship[] @relation("ConceptSource")
  incoming       ConceptRelationship[] @relation("ConceptTarget")

  learnerEvidence LearningEvidence[]
  objectives      LearningObjective[]
  candidates      ConceptCandidate[]
  proposals       ConceptAlignmentProposal[]
  curatorRules    CuratorRule[]
  curriculumNodes CurriculumNode[]
  conceptMasteries LearnerConceptMastery[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([normalizedName, domain, gradeBand])
  @@index([conceptType])
  @@index([domain])
  @@index([gradeBand])
  @@index([status])
}

// ------------------------------------------------------------
// Phase 2.5 Additions: Alignment, Vectors, Governance
// ------------------------------------------------------------

// 1. Immutable Policy Configuration Snapshot
model AlignmentPolicy {
  id                 String   @id @default(uuid())
  version            Int      @unique
  cosineWeight       Float    @default(0.40)
  gradeWeight        Float    @default(0.25)
  domainWeight       Float    @default(0.15)
  taxonomyWeight     Float    @default(0.10)
  curatorWeight      Float    @default(0.10)
  autoLinkThreshold  Float    @default(0.88)
  reviewThreshold    Float    @default(0.70)
  createdBy          String   @default("SYSTEM")
  createdAt          DateTime @default(now())

  decisions          AlignmentDecisionLog[]
}

// 2. Dedicated Vector Persistence Model
model SemanticEmbedding {
  id                 String     @id @default(uuid())
  entityType         EntityType
  entityId           String

  embeddingModel     String     @default("text-embedding-3-small")
  embeddingVersion   Int        @default(1)
  dimensions         Int        @default(1536)
  embedding          Float[]
  inputFingerprint   String     // SHA256 of sanitized input string

  createdAt          DateTime   @default(now())

  @@unique([entityType, entityId, embeddingModel, embeddingVersion])
  @@index([entityId])
}

// 3. Curator Queue for Medium-Confidence Proposals
model ConceptAlignmentProposal {
  id                 String           @id @default(uuid())
  candidateId        String
  candidate          ConceptCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  targetConceptId    String
  targetConcept      Concept          @relation(fields: [targetConceptId], references: [id])

  compositeScore     Float
  cosineScore        Float
  gradeBandScore     Float
  domainScore        Float
  taxonomyScore      Float
  curatorScore       Float

  policyVersion      Int              @default(1)
  embeddingModel     String           @default("text-embedding-3-small")
  embeddingVersion   Int              @default(1)

  status             ProposalStatus   @default(PENDING)
  curatorNotes       String?
  reviewedBy         String?
  reviewedAt         DateTime?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateId])
  @@index([targetConceptId])
  @@index([status])
}

// 4. Auditable 5-Score Decision History Log
model AlignmentDecisionLog {
  id                 String                @id @default(uuid())
  candidateId        String
  candidateKey       String
  targetConceptId    String?

  decisionType       AlignmentDecisionType
  compositeScore     Float
  cosineScore        Float
  gradeBandScore     Float
  domainScore        Float
  taxonomyScore      Float
  curatorScore       Float

  policyVersion      Int
  policy             AlignmentPolicy       @relation(fields: [policyVersion], references: [version])

  embeddingModel     String                @default("text-embedding-3-small")
  embeddingVersion   Int                   @default(1)

  executedBy         String                // "SYSTEM_AUTO" or Curator User ID
  createdAt          DateTime              @default(now())

  @@index([candidateKey])
  @@index([targetConceptId])
  @@index([decisionType])
}

// 5. Versioned & Disableable Curator Rules
model CuratorRule {
  id                 String    @id @default(uuid())
  ruleVersion        Int       @default(1)
  active             Boolean   @default(true)

  rawPhrase          String
  normalizedPhrase   String
  domain             String
  gradeBand          GradeBand

  action             String    // "MAP_TO_CONCEPT" | "FORCE_NEW_CONCEPT"
  targetConceptId    String?
  targetConcept      Concept?  @relation(fields: [targetConceptId], references: [id])

  createdBy          String    // Curator User ID
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([normalizedPhrase, domain, gradeBand, ruleVersion])
  @@index([normalizedPhrase])
  @@index([active])
}

// ------------------------------------------------------------
// Learning Objective  (Associated with Canonical Concept)
// ------------------------------------------------------------

model LearningObjective {
  id              String   @id @default(uuid())
  conceptId       String
  concept         Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  code            String?  // e.g. "MATH.1.ADD.1"
  description     String   // e.g. "Add two single-digit integers <= 5."
  complexityLevel Int      @default(1) // Mastery depth (1-10)
  bloomTaxonomy   String?  // REMEMBER, UNDERSTAND, APPLY, ANALYZE, EVALUATE, CREATE

  nodeObjectives  CurriculumNodeObjective[]
  learningEvidences LearningEvidence[]
  objectiveMasteries LearnerObjectiveMastery[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conceptId])
  @@index([complexityLevel])
}

// ------------------------------------------------------------
// Concept Candidate Staging Model
// ------------------------------------------------------------

model ConceptCandidate {
  id              String           @id @default(uuid())
  chunkId         String
  chunk           ContentChunk     @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  candidateKey    String           @unique // SHA256(chunkId|normalizedLabel|domain|gradeBand)
  rawLabel        String
  normalizedLabel String
  domain          String?          @default("General")
  gradeBand       GradeBand        @default(PRIMARY)
  confidence      Float            @default(1.0)
  status          CandidateStatus  @default(PENDING)

  resolvedConceptId String?
  resolvedConcept   Concept?       @relation(fields: [resolvedConceptId], references: [id])

  proposals       ConceptAlignmentProposal[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([chunkId])
  @@index([status])
  @@index([normalizedLabel])
}

// ------------------------------------------------------------
// Concept <-> Content Chunk  (many-to-many join)
// ------------------------------------------------------------

model ConceptChunk {
  id          String       @id @default(uuid())

  conceptId   String
  concept     Concept      @relation(fields: [conceptId], references: [id])

  chunkId     String
  chunk       ContentChunk @relation(fields: [chunkId], references: [id])

  relevance   Float?
  confidence  Float?

  createdAt   DateTime @default(now())

  @@unique([conceptId, chunkId])
  @@index([chunkId])
}

// ------------------------------------------------------------
// Canonical Knowledge Graph  (Concept -> Concept)
// ------------------------------------------------------------

model ConceptRelationship {
  id               String                  @id @default(uuid())

  sourceId         String
  source           Concept                 @relation("ConceptSource", fields: [sourceId], references: [id])

  targetId         String
  target           Concept                 @relation("ConceptTarget", fields: [targetId], references: [id])

  relationshipType ConceptRelationshipType

  strength         Float                   @default(1.0)
  explanation      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceId, targetId, relationshipType])
  @@index([sourceId])
  @@index([targetId])
}

// ------------------------------------------------------------
// Learning Evidence  (Bridge: sessionId -> LearningSession optional)
// ------------------------------------------------------------

model LearningEvidence {
  id              String           @id @default(uuid())
  evidenceKey     String?          @unique // SHA256 / UUID unique evidence key

  learnerId       String
  learner         Learner          @relation(fields: [learnerId], references: [id])

  conceptId       String?
  concept         Concept?         @relation(fields: [conceptId], references: [id])

  learningObjectiveId String?
  learningObjective   LearningObjective? @relation(fields: [learningObjectiveId], references: [id])

  sessionId       String?
  session         LearningSession? @relation(fields: [sessionId], references: [id])

  evidenceType    EvidenceType
  outcome         EvidenceOutcome

  score           Float?
  confidence      Float?

  response        String?
  reasoning       String?
  misconception   String?

  sourceReference Json?

  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([learnerId, conceptId])
  @@index([conceptId])
  @@index([evidenceType])
  @@index([observedAt])
}

// ------------------------------------------------------------
// Phase 2.6 Additions: Universal Curriculum & Board Mappings
// ------------------------------------------------------------

// 1. Immutable Master Curriculum Version Snapshot
model CurriculumStructure {
  id                 String           @id @default(uuid())
  version            Int              @unique
  name               String           @default("EKAGURU Universal Curriculum")
  description        String?
  domain             String           @default("General")
  status             CurriculumStatus @default(DRAFT)

  inputFingerprint   String           @default("FINGERPRINT_DEFAULT") // SHA256 of active concepts, edges & objectives

  createdBy          String           @default("SYSTEM")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  nodes              CurriculumNode[]
  prerequisites      CurriculumPrerequisite[]
  boardMappings      BoardCurriculumMapping[]
  enrollments        LearnerCurriculumEnrollment[]
  frontiers          LearnerCurriculumFrontier[]

  @@unique([domain, inputFingerprint])
  @@index([domain])
}

// 2. Universal Curriculum Node (Backbone Sequence)
model CurriculumNode {
  id                    String              @id @default(uuid())
  structureId           String
  structure             CurriculumStructure @relation(fields: [structureId], references: [id])

  conceptId             String
  concept               Concept             @relation(fields: [conceptId], references: [id])

  gradeBand             GradeBand
  sequenceIndex         Int                 // Deterministic topological index
  masteryDepthLevel     Int                 @default(1) // Mastery depth 1-10

  createdAt             DateTime            @default(now())

  nodeObjectives        CurriculumNodeObjective[]
  boardMappings         BoardNodeMapping[]
  frontiers             LearnerCurriculumFrontier[]

  outgoingPrereqs       CurriculumPrerequisite[] @relation("PrereqSource")
  incomingPrereqs       CurriculumPrerequisite[] @relation("PrereqTarget")

  @@unique([structureId, conceptId, gradeBand])
  @@index([structureId, sequenceIndex])
  @@index([conceptId])
  @@index([gradeBand])
}

// 3. Node-to-Objective Join Model
model CurriculumNodeObjective {
  id                    String            @id @default(uuid())
  curriculumNodeId      String
  curriculumNode        CurriculumNode    @relation(fields: [curriculumNodeId], references: [id])

  learningObjectiveId   String
  learningObjective     LearningObjective @relation(fields: [learningObjectiveId], references: [id])

  sequenceIndex         Int               @default(1)
  createdAt             DateTime          @default(now())

  @@unique([curriculumNodeId, learningObjectiveId])
  @@index([curriculumNodeId])
}

// 4. Explicit Versioned Prerequisite Edge Model
model CurriculumPrerequisite {
  id                    String              @id @default(uuid())
  structureId           String
  structure             CurriculumStructure @relation(fields: [structureId], references: [id])

  sourceNodeId          String
  sourceNode            CurriculumNode      @relation("PrereqSource", fields: [sourceNodeId], references: [id])

  targetNodeId          String
  targetNode            CurriculumNode      @relation("PrereqTarget", fields: [targetNodeId], references: [id])

  prerequisiteType      String              @default("PREREQUISITE")
  confidence            Float               @default(1.0)
  createdAt             DateTime            @default(now())

  @@unique([structureId, sourceNodeId, targetNodeId])
  @@index([structureId])
}

// 5. Board Curriculum Alignment Mapping (CBSE / ICSE / Cambridge Projection)
model BoardCurriculumMapping {
  id                 String              @id @default(uuid())
  structureId        String
  structure          CurriculumStructure @relation(fields: [structureId], references: [id])

  boardType          BoardType
  boardCode          String              // e.g. "CBSE_INDIA", "TELANGANA_STATE"
  jurisdiction       String              @default("INDIA")
  academicYear       String              @default("2026-2027")
  boardGrade         String              // e.g. "Class 1", "Grade 2"

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  nodeMappings       BoardNodeMapping[]

  @@unique([structureId, boardCode, academicYear, boardGrade])
  @@index([boardType])
  @@index([boardCode])
}

// 6. Board Node Specific Sequence Projection & Conflict Flagging
model BoardNodeMapping {
  id                 String                 @id @default(uuid())
  boardMappingId     String
  boardMapping       BoardCurriculumMapping @relation(fields: [boardMappingId], references: [id])

  curriculumNodeId   String
  curriculumNode     CurriculumNode         @relation(fields: [curriculumNodeId], references: [id])

  boardSequenceIndex Int                    // Board specific ordering index
  hasSequenceConflict Boolean              @default(false)
  conflictNotes      String?

  createdAt          DateTime               @default(now())

  @@unique([boardMappingId, curriculumNodeId])
  @@index([curriculumNodeId])
  @@index([hasSequenceConflict])
}

// ------------------------------------------------------------
// Phase 2.7 Additions: Learner Mastery & Adaptive Sequencing
// ------------------------------------------------------------

// 1. Immutable Mastery Policy Snapshot
model MasteryPolicy {
  id                    String           @id @default(uuid())
  version               Int              @unique
  name                  String           @default("EKAGURU Default Mastery Policy")
  recentWeight          Float            @default(0.60) // Weight for recent assessment
  decayLambda           Float            @default(0.001) // Hourly decay rate
  masteryThreshold      Float            @default(0.75) // Threshold for MASTERED
  remediationThreshold  Float            @default(0.50) // Threshold for NEEDS_REMEDIATION
  confidenceThreshold   Float            @default(0.70) // Confidence threshold

  createdBy             String           @default("SYSTEM")
  createdAt             DateTime         @default(now())

  histories             MasteryHistory[]
}

// 2. Learner Curriculum Version Enrollment (PUBLISHED Only)
model LearnerCurriculumEnrollment {
  id                    String              @id @default(uuid())
  learnerId             String
  learner               Learner             @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  structureId           String
  structure             CurriculumStructure @relation(fields: [structureId], references: [id])

  enrolledAt            DateTime            @default(now())
  active                Boolean             @default(true)

  @@unique([learnerId, structureId])
  @@index([learnerId])
}

// 3. Learner Concept-Level Mastery State (Current State)
model LearnerConceptMastery {
  id                    String        @id @default(uuid())
  learnerId             String
  learner               Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  conceptId             String
  concept               Concept       @relation(fields: [conceptId], references: [id])

  masteryScore          Float         @default(0.0) // 0.0 to 1.0
  confidence            Float         @default(0.0) // 0.0 to 1.0
  status                MasteryStatus @default(NOT_STARTED)

  policyVersion         Int           @default(1)
  attemptsCount         Int           @default(0)
  successfulCount       Int           @default(0)
  lastAssessedAt        DateTime?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([learnerId, conceptId])
  @@index([learnerId])
  @@index([conceptId])
  @@index([status])
}

// 4. Learner Objective-Level Mastery State (Current State)
model LearnerObjectiveMastery {
  id                    String            @id @default(uuid())
  learnerId             String
  learner               Learner           @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  learningObjectiveId   String
  learningObjective     LearningObjective @relation(fields: [learningObjectiveId], references: [id])

  masteryScore          Float             @default(0.0)
  status                MasteryStatus     @default(NOT_STARTED)

  policyVersion         Int               @default(1)
  lastAssessedAt        DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([learnerId, learningObjectiveId])
  @@index([learnerId])
  @@index([learningObjectiveId])
}

// 5. Immutable Mastery History Audit Log (Non-Cascading Retention)
model MasteryHistory {
  id                    String            @id @default(uuid())
  learnerId             String
  learner               Learner           @relation(fields: [learnerId], references: [id], onDelete: Restrict)

  conceptId             String?
  learningObjectiveId   String?
  evidenceKey           String            // Unique evidence key reference

  previousScore         Float
  newScore              Float
  previousStatus        MasteryStatus
  newStatus             MasteryStatus

  policyVersion         Int
  policy                MasteryPolicy     @relation(fields: [policyVersion], references: [version])

  calculatedAt          DateTime          @default(now())

  @@index([learnerId])
  @@index([evidenceKey])
  @@index([calculatedAt])
}

// 6. Learner Active Curriculum Frontier Snapshot (Derived Projection Cache)
model LearnerCurriculumFrontier {
  id                    String              @id @default(uuid())
  learnerId             String
  learner               Learner             @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  structureId           String
  structure             CurriculumStructure @relation(fields: [structureId], references: [id])

  currentNodeId         String
  currentNode           CurriculumNode      @relation(fields: [currentNodeId], references: [id])

  isRemediation         Boolean             @default(false)
  remediationReason     String?

  computedAt            DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([learnerId, structureId, currentNodeId])
  @@index([learnerId, structureId])
}