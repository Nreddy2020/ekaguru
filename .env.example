# Ekaguru Environment Variables

# NestJS Backend
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ekaguru"

# JWT Auth
JWT_SECRET="your-secret-key-change-in-production"

# Gemini LLM (Get API key from https://aistudio.google.com/app/apikey)
# Provide this at runtime through a secret manager or a local, untracked .env file.
GEMINI_API_KEY=""

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3000"
